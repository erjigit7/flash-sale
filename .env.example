# Необязательный файл. docker compose up работает без .env: все дефолты прописаны в docker-compose.yml.
# Скопируйте в .env, только если нужно что-то переопределить.

# Время удержания товара в корзине, секунды (по ТЗ 10 минут; для быстрого демо можно 60)
HOLD_TTL_SECONDS=600

# Пароль экрана магазина
SHOP_PASSWORD=shop

# Секреты (дефолты годятся только для локального запуска)
JWT_SECRET=dev-only-jwt-secret-change-me
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret

MAIL_FROM=Флэш-распродажа <noreply@flash-sale.local>

# Порты на хосте, если стандартные заняты
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=8080
PAYMENT_STUB_PORT=4000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
